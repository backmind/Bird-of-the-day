name: Bird of the Day

on:
  schedule:
    - cron: '0 7 * * *'  # 07:00 UTC — adjust to your timezone
  workflow_dispatch:

permissions:
  contents: write

jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Set up uv
        uses: astral-sh/setup-uv@v7
        with:
          version: "latest"

      - name: Install dependencies
        run: uv sync

      - name: Generate bird of the day
        env:
          EBIRD_API_KEY: ${{ secrets.EBIRD_API_KEY }}
          BOTD_LLM_API_KEY: ${{ secrets.BOTD_LLM_API_KEY }}
        run: uv run python -m scripts.generate

      - name: Commit and push changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          # These need no existence guard, which is the whole reason the
          # ones below do. They are what a repository that has published
          # even once always carries: the feed, the history, the two fixed
          # pages, and the four directories. cache/ and maps/ ship a
          # committed .gitkeep so they exist before anything fills them,
          # and assets/ carries the stylesheet, the self-hosted woff2 fonts
          # and the published basemap, without which the site cannot render.
          git add -f feed.xml history.json index.html archive.html birds/ cache/ maps/ assets/
          # Everything below is staged one path at a time, guarded on that
          # path existing first. This is not a style choice and must not be
          # folded back into the line above: "git add -f" on a literal path
          # that is not there fails with "pathspec ... did not match any
          # files" and aborts the entire invocation, leaving NOTHING staged,
          # not even the paths it had already accepted. Actions runs this
          # script under "bash -e", so that failure kills the step on the
          # spot, before the commit. One absent file costs the day.
          #
          # feed-full.xml needs a feed cap and sitemap.xml needs a configured
          # feed_link, so an instance with neither has neither file.
          # archive-*.html is here for the same reason and not a different
          # one: the month buckets are written by the site build, the site
          # build is skipped on a run where maintenance or the taxonomy fetch
          # failed, and a repository that has not committed a bucket file yet
          # then has none on disk. The glob is unquoted so the shell expands
          # it here, into one word per matching bucket; with no match it
          # stays literal and "[ -e ]" drops it, which is exactly the case
          # that used to abort the add.
          #
          # Adding a path to this step? It belongs in the loop unless you can
          # show it is present on every run that gets this far.
          for optional in archive-*.html feed-full.xml sitemap.xml robots.txt 404.html; do
            [ -e "$optional" ] && git add -f "$optional"
          done
          git diff --staged --quiet && echo "No changes to commit" && exit 0
          git commit -m "🐦 Bird of the day: $(date -u +%Y-%m-%d)"
          git pull --rebase origin main
          git push
